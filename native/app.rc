#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDI_APP ICON "../TimeCounter/app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "TimeCounter — native Windows activity counter"
   VALUE "FileVersion", "2.0.0"
   VALUE "ProductName", "TimeCounter"
   VALUE "ProductVersion", "2.0.0"
   VALUE "OriginalFilename", "TimeCounter.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDD_SETTINGS DIALOGEX 0, 0, 380, 354
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TimeCounter — настройки"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Таймаут без ввода, минут", -1, 12, 15, 168, 12
 EDITTEXT IDC_IDLE, 195, 12, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Шрифт", -1, 12, 40, 160, 12
 EDITTEXT IDC_FONT, 195, 37, 112, 15, ES_READONLY
 PUSHBUTTON "Выбрать…", IDC_PICKFONT, 312, 37, 56, 16
 LTEXT "Размер, pt", -1, 12, 65, 160, 12
 EDITTEXT IDC_FONTSIZE, 195, 62, 80, 15, WS_TABSTOP
 LTEXT "Цвет цифр", -1, 12, 90, 160, 12
 PUSHBUTTON "Выбрать цвет", IDC_COLOR, 195, 87, 112, 17
 LTEXT "Прозрачность, %", -1, 12, 115, 168, 12
 EDITTEXT IDC_ALPHA, 195, 112, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Угол экрана", -1, 12, 140, 160, 12
 COMBOBOX IDC_CORNER, 195, 137, 173, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Экран (с 1)", -1, 12, 165, 160, 12
 EDITTEXT IDC_MONITOR, 195, 162, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Отступ по горизонтали, px", -1, 12, 190, 175, 12
 EDITTEXT IDC_X, 195, 187, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Отступ по вертикали, px", -1, 12, 215, 175, 12
 EDITTEXT IDC_Y, 195, 212, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Порт HTTP (все IP)", -1, 12, 240, 160, 12
 EDITTEXT IDC_PORT, 195, 237, 80, 15, ES_NUMBER | WS_TABSTOP
 LTEXT "Токен API", -1, 12, 265, 160, 12
 EDITTEXT IDC_TOKEN, 115, 262, 253, 16, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
 AUTOCHECKBOX "Запускать вместе с Windows", IDC_AUTO, 12, 289, 225, 15, WS_TABSTOP
 LTEXT "HTTP без шифрования: используйте доверенную сеть или VPN.", -1, 12, 310, 356, 12
 DEFPUSHBUTTON "Сохранить", IDOK, 212, 330, 76, 17
 PUSHBUTTON "Отмена", IDCANCEL, 296, 330, 72, 17
END
IDD_HISTORY DIALOGEX 0, 0, 450, 290
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_MINIMIZEBOX
CAPTION "TimeCounter — история"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Предыдущих дней (+ сегодня):", -1, 8, 12, 176, 14
 EDITTEXT IDC_DAYS, 188, 8, 55, 16, ES_NUMBER | WS_TABSTOP
 CONTROL "", IDC_SPIN, UPDOWN_CLASS, UDS_ALIGNRIGHT | UDS_SETBUDDYINT | UDS_ARROWKEYS, 232, 8, 11, 16
 CONTROL "", IDC_LIST, WC_LISTVIEW, WS_CHILD | WS_VISIBLE | WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 34, 434, 248, WS_EX_CLIENTEDGE
END
